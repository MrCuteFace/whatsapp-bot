<Window x:Class="whatsapp_bot_user_management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:whatsapp_bot_user_management"
        mc:Ignorable="d"
        Title="ניהול משתמשי הבוט" Height="580" Width="820"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        MinHeight="420" MinWidth="700">
    <DockPanel Margin="28">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,24" FlowDirection="LeftToRight">
            <Image Source="Assets/BrandLogo.png" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="ניהול משתמשים" Style="{StaticResource HeaderTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
        </Grid>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,16">
            <Button x:Name="AddUserButton" Content="הוסף משתמש" Click="AddUserButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
            <Button x:Name="DeleteButton" Content="מחק נבחרים" Click="DeleteButton_Click"
                    Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0" IsEnabled="False"/>
            <Button x:Name="RefreshButton" Content="רענן" Click="RefreshButton_Click"
                    Style="{StaticResource NeutralButtonStyle}"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="4,14,4,0" TextWrapping="Wrap"/>

        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="14" Padding="4">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="UsersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="טלפון" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="שם" Binding="{Binding Name}" Width="130"/>
                    <DataGridTextColumn Header="חברה" Binding="{Binding CompanyName}" Width="160"/>
                    <DataGridTextColumn Header="תפקידים" Binding="{Binding RolesLabel}" Width="180"/>
                    <DataGridTextColumn Header="ח.פ" Binding="{Binding Hp}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
