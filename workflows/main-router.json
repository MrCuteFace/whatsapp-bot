    {
      "parameters": {
        "jsCode": "const crypto = require('crypto')\n\nconst secret = $env.META_APP_SECRET;\nconst headers = $input.first().json.headers;\nconst signatureHeader = headers['x-hub-signature-256'];\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nlet valid = false;\nlet expectedSignature = null;\nif(signatureHeader) {\n  expectedSignature = 'sha256=' + crypto.createHmac('sha256', secret).update(buffer).digest('hex');\n  const received = Buffer.from(signatureHeader);\n  const expected = Buffer.from(expectedSignature);\n  if (received.length === expected.length) {\n    valid = crypto.timingSafeEqual(received, expected);\n  }\n}\nreturn [{ json: { ...$input.first().json, signatureValid: valid } }];"
      },
      "type": "n8n-nodes-base.code",
