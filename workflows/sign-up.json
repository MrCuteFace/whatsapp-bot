    {
      "parameters": {
        "jsCode": "const phone = $('When Executed by Another Workflow').first().json.phone;\nconst msgType = $('When Executed by Another Workflow').first().json.msgType;\nconst body = $('When Executed by Another Workflow').first().json.body?.trim() || '';\nconst state = $input.first().json.state;\nconst name = $input.first().json.name;\nconst role = $input.first().json.role;\n\nconst validRoles = ['shipping_agent', 'forwarder', 'customs_broker'];\n\nlet route;\nif (!state) {\n  route = 'NO_SESSION';\n} else if (state === 'STARTED') {\n  route = 'STARTED';\n} else if (state === 'NAME_CONFIRM') {\n  if (msgType === 'interactive' && body === 'confirm_name') route = 'NAME_CONFIRMED';\n  else if (msgType === 'interactive' && body === 'fix_name')  route = 'NAME_FIX';\n  else route = 'NAME_CONFIRM_INVALID';\n} else if (state === 'AWAITING_ROLE') {\n  if (msgType === 'interactive' && validRoles.includes(body)) route = 'ROLE_SELECTED';\n  else route = 'ROLE_INVALID';\n} else if (state === 'AWAITING_HP') {\n  route = 'AWAITING_HP';\n} else if (state === 'AWAITING_ADDITIONAL_ROLE') {\n  if (msgType === 'interactive' && body === 'done') route = 'ADDITIONAL_ROLE_DONE';\n  else if (msgType === 'interactive' && validRoles.includes(body)) route = 'ADDITIONAL_ROLE_SELECTED';\n  else route = 'ADDITIONAL_ROLE_INVALID';\n}\n\nreturn [{ json: { ...$input.first().json, route, phone, body, msgType, name, role } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
